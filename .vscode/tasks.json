{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Serve Docs (static)",
			"command": "python3",
			"args": [
				"-m",
				"http.server",
				"8080",
				"--directory",
				"docs"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": true
			},
			"detail": "Serve the static docs/ folder at http://localhost:8080/"
		},
		{
			"type": "shell",
			"label": "Site: Dev",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "none"
			},
			"detail": "Run Astro dev server for the website"
		},
		{
			"type": "shell",
			"label": "Site: Build",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build"
			},
			"detail": "Build the website to docs/ folder for GitHub Pages"
		}
	]
}
